# Copy to backend/.env
DATABASE_URL=postgresql+psycopg://careeros:careeros@localhost:5432/careeros
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Set true when served over HTTPS
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
AUTH_RATE_LIMIT=10/minute

# Real jobs from Adzuna (free key at developer.adzuna.com). Empty = sample jobs only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Refreshes jobs in the background every 24h when the Adzuna keys are set
JOB_REFRESH_ENABLED=true

# AI resume review and Career Coach (console.anthropic.com). Empty = AI features off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_CHAT=claude-sonnet-5-5
# Max AI calls per user per day
AI_DAILY_LIMIT=40

ENVIRONMENT=development
# Production only: same random value as PROXY_SECRET on the web app
PROXY_SECRET=

# Password reset codes by email (resend.com). Empty = reset by email is off.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend
EMAIL_FROM=CareerOS <no-reply@yourdomain.com>

# Google sign-in. In Google Cloud, add this Authorized redirect URI:
#   {FRONTEND_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
